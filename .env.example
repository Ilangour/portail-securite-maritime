# Copier ce fichier en .env.local et compléter avec vos propres identifiants.
# Ne jamais commiter .env.local (déjà exclu via .gitignore).

# --- Obligatoire ---

# Connexion Postgres — ex: https://neon.tech (plan gratuit suffisant pour tester)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# OAuth Google — https://console.cloud.google.com, doit être identique ici et
# dans config.js (CONFIG.GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com

# Secret partagé pour protéger les endpoints de Cron Job (api/backup.js,
# api/reconcile-safetyculture.js) contre un déclenchement externe
CRON_SECRET=une-valeur-aleatoire-longue

# --- Optionnel : intégration SafetyCulture (webhook + rattrapage) ---
SAFETYCULTURE_API_TOKEN=
SAFETYCULTURE_WEBHOOK_SECRET=
SAFETYCULTURE_TEMPLATE_ID=

# --- Optionnel : sauvegarde automatique quotidienne vers GitHub ---
GITHUB_BACKUP_TOKEN=
GITHUB_REPO=votre-compte/votre-depot

# --- Optionnel : monitoring d'erreurs (Sentry) ---
SENTRY_DSN=

# --- Optionnel : filet de secours Airtable (legacy, non utilisé par défaut) ---
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
